{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "targets": [
      "nsis"
    ],
    "resources": [
      "resources/meta-manager-mcp.cjs",
      "resources/windows/node.exe"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Advertpreneur"
      }
    }
  }
}
