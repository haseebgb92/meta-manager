{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Meta Manager",
  "version": "0.1.33",
  "identifier": "com.advertpreneur.metamanager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:all"
  },
  "app": {
    "windows": [
      {
        "title": "Meta Manager",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/meta-manager-mcp.cjs",
      "resources/meta-manager-proxy.cjs"
    ],
    "linux": {
      "deb": {
        "depends": [
          "nodejs",
          "openssl",
          "libnss3-tools"
        ]
      }
    }
  }
}
